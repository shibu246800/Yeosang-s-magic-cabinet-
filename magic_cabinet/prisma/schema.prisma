
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DropChannel {
  guildId    BigInt @id @map("guild_id")
  channel1Id BigInt @map("channel1_id")
  channel2Id BigInt? @map("channel2_id")
  channel3Id BigInt? @map("channel3_id")
  channel4Id BigInt? @map("channel4_id")
  channel5Id BigInt? @map("channel5_id")

  @@map("drop_channels")
}

model Player {
  userId    BigInt  @id @map("user_id")
  createdAt String  @map("created_at")
  vault     String?

  @@map("players")
}

model PlayerVault {
  userId BigInt @map("user_id")
  vault  String

  @@id([userId, vault])
  @@map("player_vaults")
}

model Balance {
  userId   BigInt @id @map("user_id")
  glimmers Int    @default(0)

  @@map("balances")
}

model Bag {
  userId   BigInt @map("user_id")
  cardId   BigInt @map("card_id")
  quantity Int    @default(0)

  @@id([userId, cardId])
  @@map("bag")
}

model DailyData {
  userId     BigInt  @id @map("user_id")
  lastClaimAt String? @map("last_claim_at")

  @@map("daily_data")
}

model BoosterTicket {
  ticketId      Int     @id @default(autoincrement()) @map("ticket_id")
  userId        BigInt  @map("user_id")
  boosterId     String  @map("booster_id")
  receivedAt    String  @map("received_at")
  activatedAt   String? @map("activated_at")
  expiresAt     String? @map("expires_at")
  usesRemaining Int?    @map("uses_remaining")
  source        String  @default("daily")

  @@map("booster_tickets")
}

model PlayerBadge {
  userId    BigInt  @map("user_id")
  badgeId   String  @map("badge_id")
  badgeName String  @map("badge_name")
  badgeEmote String? @map("badge_emote")

  @@id([userId, badgeId])
  @@map("player_badges")
}

model PlayerAchievement {
  userId         BigInt @map("user_id")
  achievementId  String @map("achievement_id")
  achievementName String @map("achievement_name")
  globalRank     Int    @map("global_rank")

  @@id([userId, achievementId])
  @@map("player_achievements")
}

model PlayerCardInventory {
  userId   BigInt @map("user_id")
  cardId   BigInt @map("card_id")
  quantity Int    @default(1)

  @@id([userId, cardId])
  @@map("player_card_inventory")
}
