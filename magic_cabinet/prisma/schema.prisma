generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DropChannel {
  guild_id   BigInt @id
  channel1_id BigInt
  channel2_id BigInt?
  channel3_id BigInt?
  channel4_id BigInt?
  channel5_id BigInt?

  @@map("drop_channels")
}

model Player {
  user_id    BigInt @id
  created_at String
  vault      String?

  @@map("players")
}

model PlayerVault {
  user_id BigInt
  vault   String

  @@id([user_id, vault])
  @@map("player_vaults")
}

model Balance {
  user_id  BigInt @id
  glimmers BigInt @default(0)

  @@map("balances")
}

model Bag {
  user_id  BigInt
  card_id  BigInt
  quantity Int    @default(0)

  @@id([user_id, card_id])
  @@map("bag")
}

model DailyData {
  user_id       BigInt @id
  last_claim_at String?

  @@map("daily_data")
}

model BoosterTicket {
  ticket_id      BigInt @id @default(autoincrement())
  user_id        BigInt
  booster_id     String
  received_at    String
  activated_at   String?
  expires_at     String?
  uses_remaining Int?
  source         String @default("daily")

  @@map("booster_tickets")
}

model PlayerBadge {
  user_id     BigInt
  badge_id    String
  badge_name  String
  badge_emote String?

  @@id([user_id, badge_id])
  @@map("player_badges")
}

model PlayerAchievement {
  user_id         BigInt
  achievement_id  String
  achievement_name String
  global_rank     Int

  @@id([user_id, achievement_id])
  @@map("player_achievements")
}

model PlayerCardInventory {
  user_id  BigInt
  card_id  BigInt
  quantity Int    @default(1)

  @@id([user_id, card_id])
  @@map("player_card_inventory")
}

model WeeklyChallenge {
  user_id             BigInt @id
  week_started        String
  task_data           String
  guaranteed_claimed  Int    @default(0)
  reward_claimed      Int    @default(0)

  @@map("weekly_challenges")
}

model WeeklyProgress {
  user_id   BigInt
  task_id   String
  progress  Int    @default(0)
  completed Int    @default(0)

  @@id([user_id, task_id])
  @@map("weekly_progress")
}

model WeeklyNotification {
  id         BigInt @id @default(autoincrement())
  user_id    BigInt
  task_id    String
  created_at String
  sent       Int    @default(0)

  @@map("weekly_notifications")
}

model WeeklyDelivery {
  user_id    BigInt @id
  guild_id   BigInt
  channel_id BigInt

  @@map("weekly_delivery")
}

model WeeklyPendingReward {
  reward_id  BigInt @id @default(autoincrement())
  user_id    BigInt
  reward_type String
  amount     BigInt @default(0)
  task_id    String?
  claimed    Int    @default(0)
  created_at String

  @@map("weekly_pending_rewards")
}

model EarnData {
  user_id       BigInt @id
  last_claim_at String?

  @@map("earn_data")
}

model BlindBox {
  user_id  BigInt @id
  quantity Int    @default(0)

  @@map("blind_boxes")
}

model CollectionReward {
  user_id      BigInt
  collection_id String
  claimed      Int     @default(0)
  claimed_at   String?

  @@id([user_id, collection_id])
  @@map("collection_rewards")
}

model PlayerLegendary {
  user_id      BigInt
  collection_id String
  legendary_id String
  claimed_at   String?

  @@id([user_id, collection_id])
  @@map("player_legendary")
}

model BoosterActivationLog {
  id           BigInt @id @default(autoincrement())
  user_id      BigInt
  ticket_id    BigInt?
  activated_at String?

  @@map("booster_activation_log")
}
